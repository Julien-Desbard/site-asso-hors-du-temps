shamefully-hoist=false

# apps/cms (React 18) et apps/web (React 19) dépendent de versions différentes
# de react/@types/react. Le hoisting interne .pnpm/node_modules ne garde qu'une
# seule version par nom de package et peut faire "gagner" la mauvaise (ex. un
# @types/react@18 fantôme visible depuis apps/web, provoquant des faux conflits
# de types React). On exclut uniquement ces packages du hoisting ; le reste
# (ex. pg, zod, requis en phantom dependency par certains paquets Payload/
# hookform) continue de bénéficier du hoisting par défaut.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
hoist-pattern[]=!react
hoist-pattern[]=!react-dom

# Autorise les build scripts des dépendances natives requises
approve-builds=true
