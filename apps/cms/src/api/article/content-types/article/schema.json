{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Actualités de l'association"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "extrait": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "contenu": {
      "type": "blocks"
    },
    "image_principale": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "galerie": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "lien_externe": {
      "type": "string"
    },
    "a_la_une": {
      "type": "boolean",
      "default": false
    }
  }
}
